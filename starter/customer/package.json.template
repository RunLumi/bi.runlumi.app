{
  "name": "__CUSTOMER_ID__-lumi-app",
  "version": "0.1.8",
  "private": true,
  "description": "Lumi BI customer application for __CUSTOMER_ID__. Consumes exact released @runlumi core artifacts at build time.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@runlumi/core": "__CORE_TARBALL__",
    "@runlumi/cloudflare": "__CLOUDFLARE_TARBALL__",
    "@runlumi/ui": "__UI_TARBALL__",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "@tanstack/react-query": "5.102.8",
    "@tabler/icons-react": "3.34.1",
    "@fontsource-variable/geist": "5.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "@tailwindcss/vite": "4.3.3",
    "shadcn": "4.21.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p apps/worker && tsc --noEmit",
    "validate": "node --experimental-strip-types scripts/validate.mjs",
    "upgrade": "node --experimental-strip-types scripts/upgrade.mjs",
    "deploy:plan": "node --experimental-strip-types scripts/deploy-plan.mjs",
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "test": "node --experimental-strip-types --test customer/tests/*.test.mjs",
    "migrate": "node --experimental-strip-types scripts/migrate.mjs"
  }
}
