---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { createStructuredData, serializeJsonLd } from '../lib/geo';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
const structuredData = noindex ? null : createStructuredData({
  canonical, title, description, includeFaq: Astro.url.pathname === '/',
});
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F4F0E8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="describedby" type="text/plain" href={`${site.origin}/llms.txt`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lumi BI: Thấy rõ kinh doanh. Biết việc cần làm. Hình giới thiệu sản phẩm." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.origin}/social-card.png`} />
    {structuredData && <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
    <script is:inline src="/scripts/site.js" defer></script>
  </head>
  <body>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
