---
import '../styles/global.css';
import '../styles/readability.css';
import Brand from '../components/Brand.astro';
import { site, pilotHref } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Lumi BI · Thấy rõ tiền. Nắm chắc hàng. Biết việc cần làm.', description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F4F0E8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/mark.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Lumi BI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline src="/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Đến nội dung chính</a>
    <header class="site-header">
      <div class="container header-inner">
        <Brand />
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
          <span>Menu</span><svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 6h14M3 14h14" /></svg>
        </button>
        <nav id="site-nav" aria-label="Điều hướng chính">
          <a href="/#san-pham">Sản phẩm</a><a href="/#ket-noi">Kết nối</a><a href="/#cach-trien-khai">Cách triển khai</a>
        </nav>
        <a class="button button-small header-cta" href="/#pilot">Trao đổi pilot <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top"><Brand /><p>Rõ dữ liệu. Vững quyết định.</p><a href={pilotHref}>{site.email} <span aria-hidden="true">↗</span></a></div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} Lumi · Commerce Intelligence</span><span>Được xây dựng cho doanh nghiệp Việt.</span><a href="/privacy/">Quyền riêng tư</a></div>
    </footer>
  </body>
</html>
