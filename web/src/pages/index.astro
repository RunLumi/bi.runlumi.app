---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductPreview from '../components/ProductPreview.astro';
import { pilotHref, site } from '../data/site';
const questions = [
  { number: '01', tag: 'MONEY TRUTH', title: 'Bán nhiều hơn.\nCó thực sự còn lại nhiều hơn?', text: 'Hướng tới đối chiếu doanh thu, hoàn trả, giá vốn và các khoản phí. Tách rõ lãi đóng góp, lợi nhuận và tiền thực nhận.', detail: 'Không lấy doanh thu thay cho dòng tiền.' },
  { number: '02', tag: 'STOCK DECISIONS', title: 'Hàng nào sắp thiếu?\nTiền đang nằm ở đâu?', text: 'Đặt tồn kho cạnh nhịp bán và thời gian nhập hàng. Nhìn ra thứ cần kiểm tra trước khi nhập thêm hoặc chạy khuyến mãi.', detail: 'Mọi ước tính đều đi cùng giả định.' },
  { number: '03', tag: 'OPERATIONS EXCEPTIONS', title: 'Trong hàng trăm việc,\nviệc nào cần bạn hôm nay?', text: 'Hướng tới gom đơn chậm, hoàn trả cần đối chiếu và nguồn dữ liệu còn thiếu thành một danh sách có thứ tự ưu tiên.', detail: 'Ít phải lục tìm. Rõ việc cần xác minh.' },
];
const faqs = [
  { q: 'Lumi BI đã dùng được cho cửa hàng của tôi chưa?', a: 'Lumi BI hiện là foundation preview, chưa phải bản production được kiểm chứng với nhà bán hàng. Repo đã có nền tảng phân quyền, dữ liệu theo doanh nghiệp và dashboard chi phí thao tác. Connector Nhanh.vn, Haravan, Shopee và các phép tính commerce vẫn đang phát triển. Buổi trao đổi pilot dùng để xác định phạm vi khả thi, không phải lời hứa bật là chạy.' },
  { q: 'Tôi có phải thay phần mềm bán hàng đang dùng không?', a: 'Không phải thay hệ thống là hướng thiết kế của Lumi BI. Mục tiêu là kết nối dữ liệu từ những công cụ bạn đang dùng. Khả năng kết nối cụ thể phụ thuộc quyền API, gói dịch vụ, trường dữ liệu và các giới hạn của từng nền tảng; những điều này cần kiểm tra trước pilot.' },
  { q: 'Các con số trên website có phải kết quả của khách hàng?', a: 'Không. Toàn bộ dashboard trên trang là dữ liệu giả lập, được ghi nhãn rõ. Chúng minh họa cách trình bày công thức, nguồn, giới hạn và việc cần kiểm tra, không phải case study, dự báo hay cam kết tăng trưởng.' },
  { q: 'Lumi BI có tự thay đổi đơn hàng hay đặt hàng không?', a: 'Không. Landing page này không kết nối hệ thống vận hành. Định hướng của BI là đọc, đối chiếu và giải thích dữ liệu. Tác vụ có ảnh hưởng bên ngoài thuộc một ranh giới quyền và phê duyệt riêng, không được ngầm cho phép chỉ vì AI đưa ra gợi ý.' },
  { q: 'Chi phí và thời gian triển khai được xác định thế nào?', a: 'Sau khi làm rõ một quyết định cần cải thiện, nguồn dữ liệu và tiêu chí nghiệm thu, hai bên mới thống nhất phạm vi, lịch triển khai và chi phí. Hiện trang này không công bố bảng giá hoặc thời hạn triển khai cố định.' },
  { q: 'Tôi cần chuẩn bị gì cho buổi trao đổi?', a: 'Tên các hệ thống đang dùng, một câu hỏi kinh doanh chưa trả lời tốt và một ví dụ báo cáo đã ẩn thông tin nhạy cảm là đủ để bắt đầu. Không gửi mật khẩu, API key, thông tin khách hàng hoặc dữ liệu tài chính chi tiết qua email ban đầu.' },
];
---
<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-kicker"><p class="eyebrow">LUMI BI / COMMERCE INTELLIGENCE</p><a class="preview-status" href="#pilot"><span aria-hidden="true"></span> Product preview · Trao đổi pilot <span aria-hidden="true">↗</span></a></div>
    <div class="hero-grid"><h1 id="hero-title">Thấy rõ tiền.<br />Nắm chắc hàng.<br /><span class="headline-last">Biết việc cần làm.</span></h1><div class="hero-copy"><span class="editorial-line" aria-hidden="true"></span><p class="hero-lede">Dữ liệu ở nhiều nơi.<br />Quyết định cần một bức tranh rõ.</p><p>Lumi BI đang được xây dựng để kết nối các kênh bán hàng, làm rõ con số và chỉ ra điều cần chú ý. Không bắt doanh nghiệp làm lại từ đầu.</p><div class="hero-actions"><a class="button" href="#pilot">Trao đổi về doanh nghiệp bạn <span aria-hidden="true">↗</span></a><a class="text-link" href="#ban-xem-truoc">Khám phá bản xem trước <span aria-hidden="true">↓</span></a></div></div></div>
    <div class="hero-bottom"><p>MỘT NƠI ĐỂ HIỂU ĐÚNG<br /><strong>Tiền · Hàng · Vận hành</strong></p><span>Giữ hệ thống đang dùng.<br />Thêm một lớp hiểu biết.</span><a href="#ban-xem-truoc" aria-label="Cuộn tới bản xem trước" class="scroll-cue"><span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="preview-section container" aria-label="Bản xem trước sản phẩm"><ProductPreview /><div class="preview-caption"><span>01 / TỪ CON SỐ ĐẾN NGỮ CẢNH</span><p>Không chỉ một biểu đồ đẹp. Còn là công thức, bằng chứng và điều chưa biết.</p></div></section>
  <section class="section container" id="san-pham" aria-labelledby="product-title">
    <div class="section-intro"><p class="eyebrow">BA GÓC NHÌN / MỘT HƯỚNG ĐI</p><div class="section-heading"><h2 id="product-title">Không thiếu báo cáo.<br />Chỉ thiếu câu trả lời rõ.</h2><p>Hướng sản phẩm của Lumi BI bắt đầu từ ba câu hỏi thực tế của người điều hành, không bắt đầu từ một rừng biểu đồ.</p></div></div>
    <div class="decision-grid">{questions.map(item => <article class="decision-card"><div class="card-number"><span>{item.number}</span><span class="eyebrow">{item.tag}</span></div><h3>{item.title.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3><p>{item.text}</p><div class="card-foot"><span class="source-dot" aria-hidden="true"></span>{item.detail}</div></article>)}</div>
  </section>
  <section class="integration-section" id="ket-noi" aria-labelledby="integration-title"><div class="container section">
    <div class="section-intro"><p class="eyebrow">KẾT NỐI / KHÔNG THAY THẾ</p><div class="section-heading"><h2 id="integration-title">Công cụ quen thuộc.<br />Một góc nhìn mới.</h2><p>Hướng tới kết nối những nơi dữ liệu đang sống, thống nhất cách hiểu trước khi đưa chúng lên cùng một màn hình.</p></div></div>
    <div class="connection-flow"><div class="connection-sources"><p class="small-label">HỆ THỐNG BẠN ĐANG DÙNG</p><div class="source-row"><span>Nhanh.vn</span><small>Trong lộ trình</small></div><div class="source-row"><span>Shopee</span><small>Trong lộ trình</small></div><div class="source-row"><span>Haravan</span><small>Trong lộ trình</small></div><div class="source-row"><span>File & hệ thống nội bộ</span><small>Đánh giá theo pilot</small></div></div><span class="flow-arrow" aria-hidden="true">→</span><div class="connection-core"><img src="/brand/mark.svg" width="42" height="42" alt="" /><h3>Một cách hiểu<br />thống nhất.</h3><p>Nguồn dữ liệu<br />Định nghĩa chỉ số<br />Quyền truy cập</p><span class="quiet-label">Lumi BI</span></div><span class="flow-arrow" aria-hidden="true">→</span><div class="connection-outcome"><p class="small-label">GÓC NHÌN CẦN ĐẠT</p><h3>Tiền có rõ?<br />Hàng có đủ?<br />Việc có người lo?</h3><p>Và bằng chứng để kiểm tra lại.</p></div></div>
    <p class="integration-note">Các tên nền tảng mô tả ưu tiên tích hợp, không phải đối tác chứng nhận. Connector trực tiếp chưa được phát hành; phạm vi API cần xác minh theo từng tài khoản.</p>
  </div></section>
  <section class="section container trust-section" aria-labelledby="trust-title"><div class="trust-intro"><p class="eyebrow">NIỀM TIN / BẮT ĐẦU TỪ THIẾT KẾ</p><h2 id="trust-title">Một con số tốt<br />phải chịu được<br />câu hỏi “vì sao?”.</h2><p>Dữ liệu chưa đủ thì nói chưa đủ. AI chưa chắc thì không nói chắc. Đây là nguyên tắc Lumi BI được xây dựng theo.</p><a class="text-link" href="#ban-xem-truoc">Thử mở nguồn của con số <span aria-hidden="true">↗</span></a></div><div class="trust-list"><article><span>01</span><div><h3>Có nguồn để lần lại.</h3><p>Chỉ số cần đi cùng công thức, phạm vi thời gian và nguồn. Không trộn doanh thu, lợi nhuận và tiền thực nhận.</p></div></article><article><span>02</span><div><h3>Thiếu dữ liệu không có nghĩa là 0.</h3><p>Dữ liệu vắng, cũ hoặc chưa đầy đủ phải được nhìn thấy, không bị che sau một trạng thái “đồng bộ thành công”.</p></div></article><article><span>03</span><div><h3>Quyền truy cập đi trước truy vấn.</h3><p>Nền tảng kiểm tra danh tính và quyền doanh nghiệp trước khi chọn dữ liệu. Database riêng không được mô tả thành cách ly tuyệt đối.</p></div></article><article><span>04</span><div><h3>AI giải thích. Con người quyết định.</h3><p>Ask Lumi nằm trong lộ trình phát triển. Giải thích số liệu không đồng nghĩa với quyền gửi, sửa, xóa hay thanh toán.</p></div></article></div></section>
  <section class="section container rollout-section" id="cach-trien-khai" aria-labelledby="rollout-title"><div class="section-intro"><p class="eyebrow">CÁCH TRIỂN KHAI / NHỎ TRƯỚC, RÕ TRƯỚC</p><div class="section-heading"><h2 id="rollout-title">Bắt đầu bằng một<br />quyết định đáng cải thiện.</h2><p>Không cần ôm cả doanh nghiệp vào ngày đầu. Một câu hỏi đúng, một phạm vi kiểm chứng được, một tiêu chí thành công cụ thể.</p></div></div><ol class="rollout-grid"><li><span class="step-number">01</span><h3>Chọn câu hỏi.</h3><p>Điều gì đang khiến bạn mất thời gian, bỏ lỡ vấn đề hoặc chưa yên tâm khi quyết định?</p><span class="step-output">Đầu ra: phạm vi pilot</span></li><li><span class="step-number">02</span><h3>Kiểm tra dữ liệu.</h3><p>Làm rõ quyền truy cập, định nghĩa chỉ số, phần dữ liệu còn thiếu và khả năng đối chiếu.</p><span class="step-output">Đầu ra: tiêu chí nghiệm thu</span></li><li><span class="step-number">03</span><h3>Chứng minh rồi mở rộng.</h3><p>Đối chiếu kết quả với nguồn. Chỉ mở rộng khi con số đúng và thực sự giúp một quyết định.</p><span class="step-output">Đầu ra: tiếp tục hoặc dừng có căn cứ</span></li></ol></section>
  <section class="pilot-section container" id="pilot" aria-labelledby="pilot-title"><div class="pilot-sheet"><div><p class="eyebrow">CÙNG XÂY TỪ BÀI TOÁN THẬT</p><h2 id="pilot-title">Câu hỏi nào về<br />doanh nghiệp khiến<br />bạn chưa yên tâm?</h2><p>Hãy bắt đầu từ đó. Cùng làm rõ dữ liệu cần có, phạm vi khả thi và cách kiểm chứng, trước khi nói đến triển khai.</p></div><div class="pilot-action"><span class="pilot-overline">TRAO ĐỔI PILOT</span><h3>Một cuộc trao đổi.<br />Một bài toán cụ thể.</h3><p>Cho Lumi biết hệ thống bạn đang dùng và điều bạn muốn hiểu rõ hơn.</p><a class="button" href={pilotHref}>Gửi bài toán cho Lumi <span aria-hidden="true">↗</span></a><span class="contact-hint">Mở ứng dụng email của bạn.<br />Website không tự gửi hoặc lưu đăng ký.</span><div class="email-fallback"><a href={`mailto:${site.email}`}>{site.email}</a><button type="button" data-copy-email={site.email} hidden>Sao chép email</button><span class="copy-status" role="status" aria-live="polite"></span></div></div></div><p class="pilot-safety">Chỉ cần mô tả tổng quan. Không gửi mật khẩu, API key hoặc dữ liệu khách hàng qua email ban đầu.</p></section>
  <section class="section container faq-section" aria-labelledby="faq-title"><div><p class="eyebrow">TRƯỚC KHI BẮT ĐẦU</p><h2 id="faq-title">Nói rõ<br />để đi đúng.</h2></div><div class="faq-list">{faqs.map(item => <details class="faq-item"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></section>
</SiteLayout>
