---
import Brand from './Brand.astro';
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-top">
    <div><a href="/" class="brand-link" aria-label="Lumi BI · Trang chủ"><Brand /></a><p>Hiểu con số. Vững quyết định.</p></div>
    <div class="footer-links"><a href={`mailto:${site.email}`}>{site.email}</a><a href="/quyen-rieng-tu/">Quyền riêng tư</a><a href="https://runlumi.app" rel="noopener">Hệ sinh thái Lumi ↗</a></div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} Lumi. Bảo lưu mọi quyền.</span><span>Giới thiệu Lumi BI · Sản phẩm đang phát triển.</span></div>
</footer>
